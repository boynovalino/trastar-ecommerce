# TRASTAR only. Development secret values belong in a protected environment, not Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/trastar_dev?sslmode=require
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
TRASTAR_ENV=development
# Also requires VERCEL_ENV=preview when deployed on Vercel.
ALLOW_PREVIEW_SIMULATION=false
# Development-only initial admin provisioning:
TRASTAR_INITIAL_ADMIN_EMAIL=admin@example.invalid
TRASTAR_INITIAL_ADMIN_PASSWORD=generated-private-password-at-least-12-chars
